# ==============================================
# CONFIGURACIÓN DE WHAZAAA FRONTEND
# ==============================================
# Copia este archivo a .env y configura tus valores

# API Backend
VITE_API_URL=http://localhost:3000/api

# ==============================================
# MONETIZACIÓN DE VIDEOS - APPLIXIR
# ==============================================
# Para ganar dinero con los videos que ven tus usuarios,
# necesitas crear una cuenta en: https://www.applixir.com
#
# Pasos:
# 1. Regístrate en https://www.applixir.com
# 2. Crea una nueva "Game/App" para tu sitio web
# 3. Obtén tus credenciales del dashboard
# 4. Configura las variables abajo

# Tu ID de desarrollador (lo encuentras en Account > Settings)
VITE_APPLIXIR_DEV_ID=

# Tu ID de zona (lo encuentras en la configuración de tu Game/App)
VITE_APPLIXIR_ZONE_ID=

# Tu ID de juego/app (lo encuentras en Games > Tu App)
VITE_APPLIXIR_GAME_ID=

# ==============================================
# OTRAS CONFIGURACIONES (OPCIONALES)
# ==============================================

# Modo de desarrollo (true/false)
VITE_DEV_MODE=false

# Habilitar logs de debug
VITE_DEBUG=false
