# Frontend — variables para el BUILD de producción (vite build)
# Vite incrusta estas variables en el bundle estático.
# Reemplaza TU_DOMINIO.com con tu dominio real.

VITE_API_URL=https://TU_DOMINIO.com/api
VITE_SOCKET_URL=https://TU_DOMINIO.com
VITE_APP_NAME=Whazaaa

# Número WhatsApp de ventas (sin + ni espacios, formato internacional)
VITE_SALES_WA=TU_NUMERO_WA_VENTAS
VITE_SALES_EMAIL=ventas@whazaaa.com
VITE_VENDOR_PHONE=+TU_NUMERO_TELEFONO
